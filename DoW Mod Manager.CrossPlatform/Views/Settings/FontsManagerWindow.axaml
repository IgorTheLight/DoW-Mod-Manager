<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DoW_Mod_Manager.ViewModels"
        x:Class="DoW_Mod_Manager.Views.Settings.FontsManagerWindow"
        x:DataType="vm:FontsManagerViewModel"
        x:Name="Root"
        Icon="/Assets/app-icon.ico"
        Width="820" Height="640" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="Fonts Manager">

    <Panel Margin="16">
        <StackPanel IsVisible="{Binding !IsAvailable}" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding UnavailableMessage}" TextWrapping="Wrap" HorizontalAlignment="Center" />
            <Button Content="CLOSE" HorizontalAlignment="Center" Command="{Binding CloseCommand}" />
        </StackPanel>

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" IsVisible="{Binding IsAvailable}">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <TextBlock Text="UI screen width:" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ScreenWidths}" SelectedItem="{Binding SelectedWidth}" MinWidth="120" />
                <Button Content="?" Command="{Binding ShowWidthHelpCommand}"
                        ToolTip.Tip="The in-game resolution is rarely the width the game uses to pick font sizes" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="2*,2*,Auto,130" Margin="4,0,4,4">
                <TextBlock Grid.Column="0" Text="Used for" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Font file" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="Size" FontWeight="SemiBold" />
            </Grid>

            <ScrollViewer Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FontRowViewModel">
                            <Grid ColumnDefinitions="2*,2*,Auto,130" Margin="4,3" IsEnabled="{Binding Exists}">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DowFontFile}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                                <Panel Grid.Column="1">
                                    <TextBox Text="{Binding FontFileName}" VerticalAlignment="Center" />
                                    <TextBlock Text="not found!" Foreground="#FF5555" FontSize="11"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                               IsVisible="{Binding !FontFileFound}" IsHitTestVisible="False" />
                                </Panel>
                                <Button Grid.Column="2" Content="..." Margin="4,0" VerticalAlignment="Center"
                                        Command="{Binding #Root.((vm:FontsManagerViewModel)DataContext).BrowseCommand}"
                                        CommandParameter="{Binding}" />
                                <NumericUpDown Grid.Column="3" Value="{Binding Size}" Minimum="1" Maximum="200"
                                               Increment="1" FormatString="0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" Margin="0,8" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="OPEN FOLDER" Command="{Binding OpenFolderCommand}" />
                <Button Content="DEFAULTS" Command="{Binding DefaultsCommand}" />
                <Button Content="SAVE" Classes="accent" Command="{Binding SaveCommand}" />
                <Button Content="CLOSE" Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>
    </Panel>
</Window>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DoW_Mod_Manager.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Square corners everywhere, like the WinForms controls. -->
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Colours of the WinForms app: window 60,60,60, text 200,200,200, Windows selection blue. -->
                <ColorPaletteResources x:Key="Dark"
                                       RegionColor="#3C3C3C"
                                       BaseHigh="#C8C8C8"
                                       Accent="#0078D7"
                                       AltHigh="#282828" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://DowModManager/Styles/AppStyles.axaml" />
    </Application.Styles>

</Application>
